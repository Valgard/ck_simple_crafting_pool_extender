#!/usr/bin/env bash
# Simple Crafting Pool Extender — environment variables (TEMPLATE)
#
# Copy this file to `.envrc` (gitignored). Machine-level shared values
# (UNITY_BIN, SDK_PATH, CK_GAME_VERSION, MODIO_DEPS_MAP, LOC_TABLE, the ilspycmd
# PATH entry) are inherited from the parent core_keeper/.envrc — define them
# once there (copy core_keeper/.envrc.example → core_keeper/.envrc), not here.
#
#   cp .envrc.example .envrc
#   direnv allow                     # then `cd` triggers the chain
#   # or, without direnv:  source .envrc && ../utils/build.sh
#
# Under direnv, source_up_if_exists pulls the parent in on `cd`; a manual
# `source .envrc` uses the `source ../.envrc` fallback.

# --- Inherit shared values from the parent core_keeper/.envrc ---------------
if command -v source_up_if_exists >/dev/null 2>&1; then
    source_up_if_exists          # direnv: walk up to core_keeper/.envrc
elif [ -f ../.envrc ]; then
    source ../.envrc             # manual `source .envrc` fallback
fi

# --- Mod identity (project-inherent — leave as-is) --------------------------

# PascalCase name — drives SDK symlink paths and the build entry point.
export MOD_NAME="SimpleCraftingPoolExtender"

# kebab-case id, written as `name_id` in the fake mod.io state.json.
export MOD_NAME_ID="simple-crafting-pool-extender"

# One-line summary, written into state.json by utils/install-macos.sh.
export MOD_SUMMARY="Helper mod that lets other mods add a 4th+ tab to vanilla Iron/Wood/Copper/etc. Crafting workbenches. Required by some craftable-item mods."

# Fake mod.io ID — must be DISTINCT per mod. 9999999 = disable-durability,
# 9999998 = faster-talents, 9999997 = item-checklist,
# 9999996 = caveling-divining-rod.
export FAKE_MOD_ID="9999995"

# Repo root, read by the shared CLIPublishHelper to locate CHANGELOG.md.
export MOD_REPO_ROOT="$PWD"

# mod.io "Type" tags for the listing — PIPE-separated, because the values
# contain spaces. Synchronised (not just added) by the shared
# CLIPublishHelper, so a value dropped here is removed on mod.io. Valid:
# Visual, Audio, Item, NPC, Quality of Life, Overhaul, Language, World,
# Library, Other.
export CK_MODIO_TYPE="Library|Quality of Life"

# Forum tags for this mod's thread in the Core Keeper Discord's
# #available-mods channel — PIPE-separated, because "Misc / Other" contains
# spaces. Read by utils/discord_post.py; Discord allows at most five.
export CK_DISCORD_TAGS="Utilities|Misc / Other"

# Images and clips for the post, beyond the logo — PIPE-separated, in the order
# they should appear. A relative path becomes an attachment, an http(s) URL
# becomes its own follow-up message (the only route for a clip past Discord's
# upload ceiling). Empty is legitimate here, unlike CK_DISCORD_TAGS: it means
# the mod has nothing to show beyond its logo.
export CK_DISCORD_MEDIA="sources/simple-crafting-pool-extender-iron-workbench.png|sources/simple-crafting-pool-extender-carpenter-workbench.png"
